# AffectSense AI Security & Session Configuration

# Enable or disable access key protection (true / false)
AUTH_ENABLED=true

# Lifetime of an active session once a key is redeemed (in minutes)
SESSION_EXPIRATION_MINUTES=10

# Allow public visitors to self-generate temporary trial keys (true / false)
# Set to 'false' so that anyone who clones the repository is locked out without an owner-issued key
ALLOW_PUBLIC_KEY_GENERATION=false

# Cooldown between key generation requests if public generation is enabled (in seconds)
KEY_GENERATION_COOLDOWN_SECONDS=60

# Admin Master Key (Permanent developer/admin bypass key)
ADMIN_MASTER_KEY=affectsense_admin_secure_key

# Cryptographic signing secret (used to mint and verify authentic keys)
AUTH_SIGNING_SECRET=AffectSense-Core-Signing-Seed-v1-998234-SECURE

# Maximum active keys stored in memory/disk before cleanup
MAX_STORED_KEYS=500

# Centralized MongoDB Key Tracking Database (Optional, for persistent centralized tracking)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/
MONGODB_DB_NAME=affectsense_ai
